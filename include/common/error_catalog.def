// Code, message, recovery hint
DOR2_ERROR(DuplicateId, "A student with this ID already exists.", "Choose a unique ID.")
DOR2_ERROR(DuplicateKey, "This key already exists.", "Choose a unique key.")
DOR2_ERROR(InvalidNumber, "Enter a valid number.", "Use a dot as the decimal separator and remove extra characters.")
DOR2_ERROR(NegativeNumber, "The value must not be negative.", "Enter zero or a positive number.")
DOR2_ERROR(NonFiniteNumber, "The value must be finite.", "Enter a finite numeric value.")
DOR2_ERROR(LimitExceeded, "The value exceeds the allowed limit.", "Reduce the value to the specified maximum.")
DOR2_ERROR(UnknownSelection, "Unknown selection.", "Choose one of the available options.")
DOR2_ERROR(IndexNotBuilt, "Indexes have not been built.", "Build indexes or use linear search.")
DOR2_ERROR(IndexStale, "Indexes are out of date.", "Rebuild indexes or use linear search.")
DOR2_ERROR(InvalidRange, "The upper bound is below the lower bound.", "Check both inclusive bounds.")
DOR2_ERROR(FileOpen, "Cannot open the file.", "Check the path and file permissions.")
DOR2_ERROR(FileRead, "Cannot read the file.", "Check the file and try again.")
DOR2_ERROR(FileWrite, "Cannot save the file.", "Check the output directory and file permissions.")
DOR2_ERROR(FileHeader, "Invalid student data header.", "Use a DOR2_STUDENT_DATA file.")
DOR2_ERROR(FileVersion, "Unsupported student data version.", "Use format version 1.")
DOR2_ERROR(FileRecord, "Invalid student record.", "Check the record format and numeric fields.")
DOR2_ERROR(FileCount, "The record count does not match the file contents.", "Check the declared count and record lines.")
DOR2_ERROR(FileTrailingData, "Unexpected data after the declared records.", "Remove extra records or correct the declared count.")
DOR2_ERROR(InvalidWorkload, "The benchmark workload is too large.", "Each count must be at most 10000 and their product at most 10000000.")
DOR2_ERROR(BenchmarkPreparation, "Cannot prepare the benchmark.", "Check the technical details and retry with a smaller dataset.")
DOR2_ERROR(NoBenchmarkResults, "No comparison results to export.", "Run a comparison first.")
DOR2_ERROR(Unexpected, "The operation could not be completed.", "Check the technical details before retrying.")
DOR2_ERROR(InvalidSearchKey, "The search key has an incorrect number of fields.", "Fill all fields for the selected attribute.")
